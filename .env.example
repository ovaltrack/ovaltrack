# Base de datos
DB_NAME=ovaltrack
DB_USER=APP
DB_PASSWORD=APP
DB_PORT=5432

# Bootstrap inicial (dejar vacío después de crear el primer administrador)
OVALTRACK_BOOTSTRAP_ADMIN_EMAIL=admin@ovaltrack.com
OVALTRACK_BOOTSTRAP_ADMIN_PASSWORD=administrador123

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=4200

# Base de datos de testing
DB_TEST_NAME=ovaltrack_test
DB_TEST_PORT=5433

# Servicios de email
EMAIL_USERNAME=email@ejemplo.com
EMAIL_PASSWORD=contraseñadeaplicacion

# Proveedor de correo: smtp (desarrollo, usa EMAIL_*), brevo (producción, API HTTP) o log (solo loguea)
MAIL_PROVIDER=smtp
# Remitente verificado en Brevo (obligatorio con MAIL_PROVIDER=brevo)
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=OvalTrack
BREVO_API_KEY=

# URL pública del frontend (enlaces de invitación y recupero de contraseña)
APP_FRONTEND_URL=http://localhost:4200
